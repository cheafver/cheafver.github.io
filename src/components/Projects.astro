---
// Projects section.
import ProjectCard from './ProjectCard.astro';
import type { Site } from '../lib/site';
interface Props { projects: Site['projects'] }
---
<section id="projects" aria-labelledby="h-proj">
  <div class="wrap">
    <div class="sh"><h2 id="h-proj">Projects</h2></div>
    <div class="projects">{Astro.props.projects.map((p) => <ProjectCard project={p} />)}</div>
  </div>
</section>
